{
  "manifest_version": 3,
  "name": "Kinema \u2014 by Kivara",
  "description": "Traduce subt\u00edtulos de Udemy al espa\u00f1ol conservando la jerga t\u00e9cnica en ingl\u00e9s. Estudia con IA, notas y flashcards.",
  "version": "1.3.0",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.udemy.com/*",
    "https://*.supabase.co/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Kinema \u2014 by Kivara",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.udemy.com/course/*"
      ],
      "js": [
        "src/content_script.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-network-bridge.js",
        "src/app/styles/*"
      ],
      "matches": [
        "https://*.udemy.com/*"
      ]
    }
  ],
  "short_name": "Kinema",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
